# ── Core (required) ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Local Mongo works out of the box. For production use a MongoDB Atlas URI (free tier).
MONGODB_URI=mongodb://127.0.0.1:27017/fitguard
# Generate a strong secret, e.g.  openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars

# Token lifetimes (optional; defaults shown)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Public base URL (used to build email links)
APP_BASE_URL=http://localhost:3001

# CORS allowlist, comma-separated (e.g. https://app.fitguard.com,http://localhost:5173).
# Leave empty in development (allows all). RECOMMENDED to set in production.
CORS_ORIGINS=

# ── Admin bootstrap — used by `npm run seed` ──────────────────────
# You choose these. The seed creates/updates this admin account (email pre-verified).
ADMIN_EMAIL=admin@fitguard.app
ADMIN_PASSWORD=change-this-admin-password

# ── Email / SMTP — needed for REAL verification & reset emails ────
# DEV: leave blank. Emails are skipped (logged to console) and the register response
# returns `devEmailVerificationToken` so you can verify without SMTP.
# PROD / real emails: obtain SMTP credentials from Gmail (App Password, requires 2FA)
# or a provider such as Mailtrap (testing), SendGrid, Brevo, or Resend.
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
VERIFY_EMAIL_URL=http://localhost:3001/api/auth/verify-email
RESET_PASSWORD_URL=http://localhost:3001/reset-password

# ── AI plan service — OPTIONAL (deterministic fallback used if unset) ──
# Filled in by the AI teammate once their FastAPI plan service is deployed.
# AI_SERVICE_KEY is a shared secret the two of you agree on.
AI_SERVICE_URL=
AI_SERVICE_KEY=
AI_SERVICE_TIMEOUT_MS=8000

# ── Media storage — OPTIONAL (local-disk storage used if unset) ───
# Local disk works with no keys (files under backend/uploads, served via /api/media/:id).
# For production, swap the media service for Cloudinary or S3 at the same boundary.
MEDIA_PROVIDER=local
